# LLM access via OpenRouter (OpenAI-compatible) — required for AI features
# Get a key at https://openrouter.ai/keys (starts with sk-or-v1-...)
AI_GATEWAY_API_KEY=sk-or-v1-your-key-here
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1

# Model (optional, defaults to openai/gpt-4o-mini).
# Any OpenRouter model id works, e.g. anthropic/claude-3.5-sonnet
# See https://openrouter.ai/models
# AI_GATEWAY_MODEL=openai/gpt-4o-mini

# EmailProvider selection. Default = mock (uses fixtures/inbox/*.eml).
# Set to "imap" to connect to a real mailbox.
EMAIL_PROVIDER=mock

# Required when EMAIL_PROVIDER=imap
# IMAP_HOST=imap.gmail.com
# IMAP_USER=you@example.com
# IMAP_APP_PASSWORD=app-specific-password   # Gmail: https://myaccount.google.com/apppasswords
# IMAP_PORT=993
# IMAP_USE_SSL=true
